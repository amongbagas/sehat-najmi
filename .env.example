# Supabase transaction pooler for Vercel runtime (port 6543)
DATABASE_URL="postgresql://postgres.project-ref:password@pooler-host:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Direct Supabase connection for Prisma migrations (port 5432)
DIRECT_URL="postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres?sslmode=require"

# NextAuth secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="replace-with-a-secure-random-secret"

# Canonical production URL, for example https://sehat.example.com
NEXTAUTH_URL="http://localhost:3000"

# AI provider; defaults to "demo" when omitted
AI_PROVIDER="demo"

# One-time production bootstrap. Remove these values after it succeeds.
ALLOW_PRODUCTION_BOOTSTRAP="false"
BOOTSTRAP_ADMIN_EMAIL="admin@sehat.demo"
BOOTSTRAP_ADMIN_NAME="Admin SEHAT"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-at-least-12-characters"

# Counselor and student passwords default to the admin password when omitted.
BOOTSTRAP_COUNSELOR_EMAIL="counselor@sehat.demo"
BOOTSTRAP_COUNSELOR_NAME="Budi (Counselor)"
BOOTSTRAP_COUNSELOR_PASSWORD=""
BOOTSTRAP_COUNSELOR_NIP="C001"
BOOTSTRAP_STUDENT_EMAIL="student@sehat.demo"
BOOTSTRAP_STUDENT_NAME="Andi (Student)"
BOOTSTRAP_STUDENT_PASSWORD=""
BOOTSTRAP_STUDENT_NIS="S001"
BOOTSTRAP_STUDENT_PARTICIPANT_ID="P001"
BOOTSTRAP_STUDENT_CLASS="10-A"
